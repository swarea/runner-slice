#!/usr/bin/env bash
#
# runner-slice: one command for the scripts in fabric/. It translates a
# subcommand into exactly one of them and adds nothing else, so every rule
# lives in one place.
#
#     runner-slice [--config DIR] COMMAND [ARGS]
#
# DIR defaults to /etc/runner-slice. It is never taken from the environment:
# root acts on it.
set -euo pipefail

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
HOME_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
FABRIC="$HOME_DIR/fabric"

usage() {
    cat >&2 <<'USAGE'
usage: runner-slice [--config DIR] COMMAND [ARGS]

Inventory, offline and unprivileged:
  validate              check the policy, release seed and every profile
  render PROFILE        print the service unit a profile renders

On the host, as root:
  plan [PROFILE]        show what apply would change; change nothing
  apply [PROFILE]       converge one profile, or every profile
  retire PROFILE [--check]
                        take a runner out, one safe step per run
  check [PROFILE]       read-only conformance of the running host

From GitHub, as an ordinary user with an authenticated gh:
  status [PROFILE]      online, busy and local service state

  version               print the version

DIR defaults to /etc/runner-slice.
USAGE
    exit 2
}

CONFIG=/etc/runner-slice
if [ "${1-}" = --config ]; then
    [ -n "${2-}" ] || usage
    CONFIG=$2
    shift 2
fi

[ "$#" -ge 1 ] || usage
command=$1
shift

# scope [PROFILE]   sets SCOPE to --all, or to --profile PROFILE. In this
# shell, not a subshell, so a usage error ends the command.
scope() {
    case "$#" in
        0) SCOPE=(--all) ;;
        1) SCOPE=(--profile "$1") ;;
        *) usage ;;
    esac
}

case "$command" in
    validate)
        [ "$#" -eq 0 ] || usage
        exec bash "$FABRIC/fabric-validate.sh" "$CONFIG"
        ;;
    render)
        [ "$#" -eq 1 ] || usage
        exec bash "$FABRIC/fabric-render-service.sh" "$CONFIG" "$1"
        ;;
    plan)
        scope "$@"
        exec bash "$FABRIC/fabric-apply.sh" --config "$CONFIG" "${SCOPE[@]}" --check
        ;;
    apply)
        scope "$@"
        exec bash "$FABRIC/fabric-apply.sh" --config "$CONFIG" "${SCOPE[@]}"
        ;;
    retire)
        case "$#" in
            1) exec bash "$FABRIC/fabric-apply.sh" --config "$CONFIG" --retire "$1" ;;
            2) [ "$2" = --check ] || usage
               exec bash "$FABRIC/fabric-apply.sh" --config "$CONFIG" --retire "$1" --check ;;
            *) usage ;;
        esac
        ;;
    check)
        scope "$@"
        exec bash "$FABRIC/fabric-check.sh" --config "$CONFIG" "${SCOPE[@]}"
        ;;
    status)
        scope "$@"
        exec bash "$FABRIC/fabric-status.sh" --config "$CONFIG" "${SCOPE[@]}"
        ;;
    version|--version)
        [ "$#" -eq 0 ] || usage
        printf 'runner-slice %s\n' "$(cat "$HOME_DIR/VERSION")"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "runner-slice: unknown command '$command'" >&2
        usage
        ;;
esac
